ateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"uint256\",\"name\":\"id\",\"type\":\"uint256\"}],\"name\":\"confirm\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"seller\",\"type\":\"address\"},{\"internalType\":\"address\",\"name\":\"token\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"amount\",\"type\":\"uint256\"},{\"internalType\":\"uint256\",\"name\":\"deadline\",\"type\":\"uint256\"},{\"internalType\":\"string\",\"name\":\"description\",\"type\":\"string\"}],\"name\":\"createOrder\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"uint256\",\"name\":\"id\",\"type\":\"uint256\"}],\"name\":\"deposit\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"uint256\",\"name\":\"id\",\"type\":\"uint256\"}],\"name\":\"dispute\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"uint256\",\"name\":\"id\",\"type\":\"uint256\"}],\"name\":\"getOrder\",\"outputs\":[{\"components\":[{\"internalType\":\"address\",\"name\":\"buyer\",\"type\":\"address\"},{\"internalType\":\"address\",\"name\":\"seller\",\"type\":\"address\"},{\"internalType\":\"address\",\"name\":\"token\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"amount\",\"type\":\"uint256\"},{\"internalType\":\"uint256\",\"name\":\"deadline\",\"type\":\"uint256\"},{\"internalType\":\"enum Escrow.Status\",\"name\":\"status\",\"type\":\"uint8\"},{\"internalType\":\"string\",\"name\":\"description\",\"type\":\"string\"}],\"internalType\":\"struct Escrow.Order\",\"name\":\"\",\"type\":\"tuple\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"orderCount\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"uint256\",\"name\":\"id\",\"type\":\"uint256\"}],\"name\":\"refund\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"uint256\",\"name\":\"id\",\"type\":\"uint256\"},{\"internalType\":\"bool\",\"name\":\"sellerWins\",\"type\":\"bool\"}],\"name\":\"resolve\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"}],\"devdoc\":{\"kind\":\"dev\",\"methods\":{},\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{},\"version\":1}},\"settings\":{\"compilationTarget\":{\"contracts/Escrow.sol\":\"Escrow\"},\"evmVersion\":\"paris\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\",\"useLiteralContent\":true},\"optimizer\":{\"enabled\":true,\"runs\":200},\"remappings\":[]},\"sources\":{\"contracts/Escrow.sol\":{\"content\":\"// SPDX-License-Identifier: MIT\\r\\npragma solidity >=0.8.0 <0.9.0;\\r\\n// \\u53ea\\u58f0\\u660e\\u6211\\u4eec\\u8981\\u7528\\u7684\\u4e09\\u4e2a\\u51fd\\u6570\\u3002Escrow \\u901a\\u8fc7\\u8fd9\\u4e2a\\u63a5\\u53e3\\u53bb\\u8c03\\u7528\\u4efb\\u4f55 ERC20 \\u5408\\u7ea6\\u3002\\r\\ninterface IERC20 {\\r\\n    function transfer(address to, uint256 value) external returns (bool);\\r\\n    function transferFrom(address from, address to, uint256 value) external returns\\r\\n    (bool);\\r\\n    function balanceOf(address account) external view returns (uint256);\\r\\n    }\\r\\n    contract Escrow {\\r\\n    // ---------- \\u72b6\\u6001\\u673a ----------\\r\\n    enum Status { Created, Paid, Completed, Refunded, Disputed }\\r\\n    struct Order {\\r\\n    address buyer;\\r\\n    address seller;\\r\\n    address token; // \\u7528\\u54ea\\u79cd ERC20 \\u7ed3\\u7b97\\r\\n    uint256 amount; // \\u6700\\u5c0f\\u5355\\u4f4d\\r\\n    uint256 deadline; // unix \\u65f6\\u95f4\\u6233\\uff0c\\u79d2\\r\\n    Status status;\\r\\n    string description;\\r\\n    }\\r\\n    // ---------- \\u5b58\\u50a8 ----------\\r\\n    address public arbiter;\\r\\n    uint256 public orderCount;\\r\\n    mapping(uint256 => Order) private _orders;\\r\\n    // ---------- \\u4e8b\\u4ef6 ----------\\r\\n    event OrderCreated(uint256 indexed id, address indexed buyer, address indexed\\r\\n    seller, address token, uint256 amount, uint256 deadline);\\r\\n    event OrderPaid(uint256 indexed id);\\r\\n    event OrderCompleted(uint256 indexed id);\\r\\n    event OrderRefunded(uint256 indexed id);\\r\\n    event OrderDisputed(uint256 indexed id, address by);\\r\\n    event OrderResolved(uint256 indexed id, bool sellerWins);\\r\\n    // ---------- \\u4fee\\u9970\\u5668 ----------\\r\\n    modifier onlyArbiter() {\\r\\n    require(msg.sender == arbiter, \\\"Escrow: caller is not the arbiter\\\");\\r\\n    _;\\r\\n    }\\r\\n    modifier onlyBuyer(uint256 id) {\\r\\n    require(msg.sender == _orders[id].buyer, \\\"Escrow: caller is not the buyer\\\");\\r\\n    _;\\r\\n    }\\r\\n    modifier inStatus(uint256 id, Status s) {\\r\\n    require(_orders[id].status == s, \\\"Escrow: wrong status\\\");\\r\\n    _;\\r\\n    }\\r\\n    constructor(address _arbiter) {\\r\\n    require(_arbiter != address(0), \\\"Escrow: arbiter is the zero address\\\");\\r\\n    arbiter = _arbiter;\\r\\n    }\\r\\n    function getOrder(uint256 id) public view returns (Order memory) {\\r\\n    require(id < orderCount, \\\"Escrow: order does not exist\\\");\\r\\n    return _orders[id];\\r\\n    }\\r\\n\\r\\n    // ---------- TODO 1\\uff1a\\u521b\\u5efa\\u8ba2\\u5355 ----------\\r\\n    function createOrder(address seller, address token, uint256 amount, uint256 deadline, string memory description) public returns (uint256) {\\r\\n        require(seller != address(0), \\\"Escrow: seller is the zero address\\\");\\r\\n        require(seller != msg.sender, \\\"Escrow: seller is the buyer\\\");\\r\\n        require(amount > 0, \\\"Escrow: amount must be positive\\\");\\r\\n        require(deadline > block.timestamp, \\\"Escrow: deadline must be in the future\\\");\\r\\n\\r\\n        uint256 id = orderCount;\\r\\n        _orders[id] = Order({\\r\\n            buyer: msg.sender,\\r\\n            seller: seller,\\r\\n            token: token,\\r\\n            amount: amount,\\r\\n            deadline: deadline,\\r\\n            status: Status.Created,\\r\\n            description: description\\r\\n        });\\r\\n        orderCount += 1;\\r\\n\\r\\n        emit OrderCreated(id, msg.sender, seller, token, amount, deadline);\\r\\n        return id;\\r\\n    }\\r\\n\\r\\n    // ---------- TODO 2\\uff1a\\u4e70\\u5bb6\\u4ed8\\u6b3e ----------\\r\\n    function deposit(uint256 id) public onlyBuyer(id) inStatus(id, Status.Created) {\\r\\n        Order storage o = _orders[id];\\r\\n\\r\\n        o.status = Status.Paid;\\r\\n        bool ok = IERC20(o.token).transferFrom(o.buyer, address(this), o.amount);\\r\\n        require(ok, \\\"Escrow: transferFrom failed\\\");\\r\\n\\r\\n        emit OrderPaid(id);\\r\\n    }\\r\\n\\r\\n    // ---------- TODO 3\\uff1a\\u4e70\\u5bb6\\u786e\\u8ba4\\u6536\\u8d27 ----------\\r\\n    function confirm(uint256 id) public onlyBuyer(id) inStatus(id, Status.Paid) {\\r\\n        Order storage o = _orders[id];\\r\\n\\r\\n        o.status = Status.Completed;\\r\\n\\r\\n        bool ok = IERC20(o.token).transfer(o.seller, o.amount);\\r\\n        require(ok, \\\"Escrow: transfer failed\\\");\\r\\n\\r\\n        emit OrderCompleted(id);\\r\\n    }\\r\\n\\r\\n    // ---------- TODO 4\\uff1a\\u8d85\\u671f\\u9000\\u6b3e ----------\\r\\n    function refund(uint256 id) public onlyBuyer(id) inStatus(id, Status.Paid) {\\r\\n        Order storage o = _orders[id];\\r\\n        require(block.timestamp > o.deadline, \\\"Escrow: deadline not reached\\\");\\r\\n\\r\\n        o.status = Status.Refunded;\\r\\n\\r\\n        bool ok = IERC20(o.token).transfer(o.buyer, o.amount);\\r\\n        require(ok, \\\"Escrow: transfer failed\\\");\\r\\n\\r\\n        emit OrderRefunded(id);\\r\\n    }\\r\\n\\r\\n    // ---------- TODO 5\\uff1a\\u53d1\\u8d77\\u4e89\\u8bae ----------\\r\\n    function dispute(uint256 id) public inStatus(id, Status.Paid) {\\r\\n        Order storage o = _orders[id];\\r\\n        require(\\r\\n            msg.sender == o.buyer || msg.sender == o.seller,\\r\\n            \\\"Escrow: caller is not buyer or seller\\\"\\r\\n        );\\r\\n\\r\\n        o.status = Status.Disputed;\\r\\n\\r\\n        emit OrderDisputed(id, msg.sender);\\r\\n    }\\r\\n\\r\\n    // ---------- TODO 6\\uff1a\\u4ef2\\u88c1 ----------\\r\\n    function resolve(uint256 id, bool sellerWins) public onlyArbiter inStatus(id, Status.Disputed) {\\r\\n        Order storage o = _orders[id];\\r\\n\\r\\n        address to;\\r\\n        if (sellerWins) {\\r\\n            o.status = Status.Completed;\\r\\n            to = o.seller;\\r\\n        } else {\\r\\n            o.status = Status.Refunded;\\r\\n            to = o.buyer;\\r\\n        }\\r\\n\\r\\n        bool ok = IERC20(o.token).transfer(to, o.amount);\\r\\n        require(ok, \\\"Escrow: transfer failed\\\");\\r\\n\\r\\n        emit OrderResolved(id, sellerWins);\\r\\n    }\\r\\n}\",\"keccak256\":\"0xa3f6711a8e3b9c4d641fc93cd6d30044259f4fe079e362aecd0e63de020dfd7c\",\"license\":\"MIT\"}},\"version\":1}",
